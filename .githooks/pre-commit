#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if echo "$staged" | grep -q '^web/'; then
  echo "→ Linting web (pnpm lint)"
  (cd "$repo_root/web" && pnpm lint)
fi

if echo "$staged" | grep -q '^api/'; then
  echo "→ Linting api (./gradlew ktlintCheck)"
  (cd "$repo_root/api" && ./gradlew ktlintCheck)
fi
